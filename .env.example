# 백엔드 주소. /api/* 와 /go/* 를 이 주소로 넘긴다 (next.config.ts rewrites). 빌드 때 들어가므로 바꾸면 재배포.
# 배포용 빌드(next build)는 이 값이 없으면 실패한다 (주소 없이 배포되는 사고 방지)
BACKEND_URL=http://localhost:8080

# 보드 편명 접두사 (예: TP 0151) / 행사명 (보드 상단)
NEXT_PUBLIC_FLIGHT_PREFIX=TP
NEXT_PUBLIC_EVENT_NAME=KOREA FINTECH WEEK 2026
# 행사일 (KST). 추첨 회차 추가 때 이 중 하루를 고르고 시각만 입력
NEXT_PUBLIC_EVENT_DAYS=2026-11-25,2026-11-26,2026-11-27

# 완료 화면 링크 버튼 (비워두면 그 버튼은 숨김). 실제 이동 주소는 백엔드의 같은 설정을 따른다
NEXT_PUBLIC_TP_WEB_URL=https://travelpass.cards/
NEXT_PUBLIC_TP_APP_IOS_URL=
NEXT_PUBLIC_TP_APP_ANDROID_URL=
NEXT_PUBLIC_CROSSHUB_URL=https://crosshub.ai/
